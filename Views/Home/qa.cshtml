@{
    Layout = null;

    ViewData["Title"] = "الأسئلة الشائعة";
}
<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <style>
        .faq-container {
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            background-color: #f2f2f2;
            border-radius: 15px;
            direction: rtl;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .faq {
            margin-bottom: 20px;
        }

            .faq h3 {
                margin-bottom: 10px;
                color: #333;
            }

            .faq p {
                background-color: #fff;
                padding: 15px;
                border-radius: 10px;
                color: #444;
            }

        .btn {
            display: inline-block;
            margin-top: 30px;
            padding: 1rem 2rem;
            font-size: 1.5rem;
            background-color: #333;
            color: white;
            text-decoration: none;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <div class="faq-container">
        <h1>الأسئلة الشائعة</h1>

        <div class="faq">
            <h3>ما هو هدف موقع المطور الصغير؟</h3>
            <p>هدفنا هو تعليم الأطفال أساسيات تطوير الويب بطريقة ممتعة وسهلة.</p>
        </div>

        <div class="faq">
            <h3>هل المحتوى مناسب للمبتدئين؟</h3>
            <p>نعم، المحتوى مصمم ليبدأ من الصفر بدون الحاجة لأي خبرة سابقة.</p>
        </div>

        <div class="faq">
            <h3>ما هي الأدوات المستخدمة في الشرح؟</h3>
            <p>نستخدم HTML, CSS, JavaScript مع أمثلة تفاعلية وتمارين عملية.</p>
        </div>

        <div class="faq">
            <h3>هل المحتوى مجاني؟</h3>
            <p>نعم، جميع الدروس والمحتويات مجانية بالكامل.</p>
        </div>

        <div style="text-align: center;">
            <a href="/Home/Index" class="btn">🔙 رجوع إلى الصفحة الرئيسية</a>
        </div>
    </div>

</body>
</html>
